; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Roses of Petial"
run/main_scene="uid://dw1r26w55mwbu"
run/enable_alt_space_menu=true
config/features=PackedStringArray("4.5", "GL Compatibility")
run/flush_stdout_on_print=true
run/max_fps=60
boot_splash/image="uid://dawm4xqwk7fka"
config/icon="uid://dawm4xqwk7fka"
boot_splash/minimum_display_time=1000

[autoload]

SignalLens="res://addons/signal_lens/autoload/signal_lens_autoload.gd"
Data="*res://Data/util/Database.gd"
PartyContainer="*res://src/party_container.gd"
_Steam="*res://util/Steam/steam.gd"
DevkitMessenger="*res://addons/steam_devkit_notifier/devkit_messenger.gd"
SteamControllerInput="*res://util/Steam/steam_controller_input.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="D:/Petial/Movies/video_proof.mp4"
naming/script_name_casing=2
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/TileMapDual/plugin.cfg", "res://addons/cba/plugin.cfg", "res://addons/gdLinter/plugin.cfg", "res://addons/signal_lens/plugin.cfg", "res://addons/simple_gdscript_formatter/plugin.cfg", "res://addons/steam_devkit_notifier/plugin.cfg", "res://addons/wingman/plugin.cfg")

